{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Native Editor",
  "version": "0.1.0",
  "identifier": "dev.ainative.editor",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AI 原生编辑器",
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 420,
        "resizable": true,
        "dragDropEnabled": true,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
