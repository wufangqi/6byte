# Keep line endings stable across platforms so prettier/rustfmt checks agree.
* text=auto eol=lf

# Rust test fixtures are byte-exact (CRLF/CR/BOM/UTF-16) and must never be normalized.
src-tauri/fixtures/** -text

*.ps1 text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

*.png binary
*.ico binary
*.icns binary
*.wasm binary
